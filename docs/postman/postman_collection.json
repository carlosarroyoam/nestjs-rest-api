          "name": "/auth",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();\r",
                  "\r",
                  "if (pm.response.status === \"OK\") {\r",
                  "    if (response) {\r",
                  "        pm.collectionVariables.set(\"token\", response.access_token);\r",
                  "    }\r",
                  "} else {\r",
                  "    pm.collectionVariables.set(\"token\", \"\");\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n\t\"username\": \"carroyom\",\r\n\t\"password\": \"secret123\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
