          "name": "/auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const response = pm.response.json();\r\n\r\nif (pm.response.status === \"OK\") {\r\n    if (response) {\r\n        pm.collectionVariables.set(\"accessToken\", response.accessToken);\r\n        pm.collectionVariables.set(\"refreshToken\", response.refreshToken);\r\n    }\r\n} else {\r\n    pm.collectionVariables.set(\"accessToken\", \"\");\r\n    pm.collectionVariables.set(\"refreshToken\", \"\");\r\n}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"username\": \"carroyom\",\r\n    \"password\": \"secret123\",\r\n    \"deviceId\": \"{{deviceId}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
